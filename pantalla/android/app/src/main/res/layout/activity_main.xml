<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Centinela"
        android:textColor="#F2F0E6"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#F2F0E6"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/deviceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#9AA392"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/queueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E8D7A8"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/haUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="URL de Home Assistant"
        android:inputType="textUri"
        android:textColor="#F2F0E6"
        android:textColorHint="#9AA392" />

    <EditText
        android:id="@+id/haToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Token de larga duración"
        android:inputType="textPassword"
        android:textColor="#F2F0E6"
        android:textColorHint="#9AA392" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/notifButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Acceso a notificaciones" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Buscar pantalla" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/bridgeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Puente activo"
        android:textColor="#F2F0E6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/forgetButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Olvidar pantalla"
        android:textColor="#C6A15B" />
</LinearLayout>
</ScrollView>
