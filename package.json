{
  "name": "centinela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Radar de mercado portable para Home Assistant OS. Motor headless; UI en Lovelace.",
  "scripts": {
    "dev": "PREVIEW_UI=true concurrently -k -n worker,ui -c cyan,magenta \"npm run dev:worker\" \"npm run dev:ui\"",
    "dev:worker": "PREVIEW_UI=true API_PORT=18765 tsx watch src/index.ts",
    "dev:ui": "vite --config preview/vite.config.ts --host 0.0.0.0 --port 38447",
    "start": "tsx src/index.ts",
    "start:preview": "PREVIEW_UI=true tsx src/index.ts",
    "build:ui": "vite build --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.9.8",
    "mqtt": "^5.14.0",
    "rss-parser": "^3.13.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
