# Centinela — copiar a .env. En HAOS estos valores van a las opciones del add-on.

# America/Santiago por defecto (RTH NY se calcula desde acá)
TZ=America/Santiago

# mqtt://core-mosquitto:1883 dentro de HAOS
# mqtt://192.168.x.x:1883 si el worker corre en otro host de la LAN
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=

# Preview HTTP solo en Cursor Cloud / desarrollo. El add-on HAOS no lo activa.
PREVIEW_UI=false
API_PORT=18765
PREVIEW_PORT=38447

# Quiet hours (se rompen en régimen CRISIS para alertas HIGH)
QUIET_START=23:00
QUIET_END=07:00

# Opcional: llama.cpp OpenAI-compatible (local o torre)
LLAMA_SERVER_URL=
# Opcional: worker remoto (torre)
REMOTE_WORKER_URL=

# FRED API (gratis) — opcional; si falta se usa Yahoo para macros
FRED_API_KEY=
